{
  "expo": {
    "name": "The_List",
    "slug": "The_List",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/gold.png",
    "scheme": "thelist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#202020",
        "foregroundImage": "./assets/images/icons/main.png",
        "backgroundImage": "./assets/images/icons/main.png",
        "monochromeImage": "./assets/images/icons/main.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/silver.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#202020",
          "image": "./assets/images/icons/silver.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icons/main.png",
          "color": "#3C9FFE",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      "./plugins/with-android-widget",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
